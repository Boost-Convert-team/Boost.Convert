SECRET_KEY=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/login/google/callback

MAX_UPLOAD_MB=2048
CONVERSION_WORKERS=6
VIDEO_FFMPEG_PRESET=veryfast
PDF_RENDER_ZOOM=1.5
CONVERSION_FILE_RETENTION_MINUTES=15
AI_TRANSCRIPT_RETENTION_MINUTES=15
CONVERSION_CLEANUP_INTERVAL_MINUTES=5
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0

# Opcao 1: URL direta do PostgreSQL.
# URLs iniciadas com postgres:// ou postgresql:// sao normalizadas para postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://boost_user:boost_password@localhost:5432/boost_converter

# Opcao 2: variaveis separadas do PostgreSQL em vez de DATABASE_URL.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=boost_converter
# POSTGRES_USER=boost_user
# POSTGRES_PASSWORD=boost_password
# POSTGRES_SSLMODE=disable
