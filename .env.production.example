# SEO/security origin behind the production reverse proxy.
APP_ENV=production
BASE_URL=https://boostconvert.com.br
FORCE_HTTPS=1
TRUST_PROXY_HEADERS=1
SESSION_COOKIE_SECURE=1

# Existing secrets and database settings remain environment-managed.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://user:password@host:5432/database

# Mercado Pago Card Payment Brick. Somente a Public Key pode ir ao frontend.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_WEBHOOK_SECRET=
